# ===== OneBot 连接 =====
# 协议端（SnowLuma）的 WebSocket 地址，默认 3001
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 如果 OneBot 服务端设了 token，这里要一致；没设就留空
ONEBOT_TOKEN=
# 小号的 QQ 号，留空则启动后自动获取
ONEBOT_SELF_ID=

# ===== 大脑 =====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=1.15
LLM_MAX_TOKENS=220

# ===== 拟人化 =====
HUMANIZE=true
CHAR_DELAY_MIN_MS=0
CHAR_DELAY_MAX_MS=0
REACTION_MIN_MS=0
REACTION_MAX_MS=0
REPLY_DELAY_MIN_MS=0
REPLY_DELAY_MAX_MS=0

# 偶尔"在忙"：12% 概率拖 15~60 秒
BUSY_CHANCE=0
BUSY_DELAY_MIN_MS=15000
BUSY_DELAY_MAX_MS=60000


# 打错字概率 / 打错后撤回的概率
TYPO_CHANCE=0.03
RECALL_CHANCE=0.5

# ===== 作息 =====
TZ_OFFSET_HOURS=8
SLEEP_START_HOUR=1
SLEEP_END_HOUR=8
WAKE_JITTER_MIN=3
WAKE_JITTER_MAX=35

# ===== 行为边界 =====
# 主人 QQ：只有这个号能授权踢人/禁言/删好友这类破坏性操作
OWNER_QQ=
# 群白名单，逗号分隔；留空=所有群都允许
GROUP_ALLOW=
# 群黑名单，优先级高于白名单
GROUP_DENY=
# true=必须 @ 才回；false=没 @ 也可能随机接话
GROUP_REQUIRE_AT=true
# 上一条为 false 时，没 @ 的接话概率
GROUP_AMBIENT_CHANCE=0.06
PRIVATE_ENABLED=true
RATE_LIMIT_PER_MIN=20
# 被直接问"你是不是 AI"，如实承认
DISCLOSE_AI=true

# ===== 自主行为 =====
# 没人理她的时候，自己决定做点什么
AUTONOMY=false
# 四条需求攒到这个数就行动
AUTONOMY_THRESHOLD=100
# 每天刷新多少活力（只扣聊天查资料以外的事）
AUTONOMY_VITALITY_MAX=100
# 每天几点把活力补满
AUTONOMY_VITALITY_RESET_HOUR=4
# 每隔多久看一次需求攒到哪了（分钟）
AUTONOMY_TICK_MIN=1
AUTONOMY_GROUP_ID=

# 四条需求每分钟涨多少
AUTONOMY_RATE_BOREDOM=1
AUTONOMY_RATE_SOCIAL=0.5
AUTONOMY_RATE_EXPRESSION=0.4
AUTONOMY_RATE_CURIOSITY=0.3

# 每件事扣多少活力（聊天和搜索不扣）
AUTONOMY_COST_SIGNATURE=10
AUTONOMY_COST_AVATAR=25
AUTONOMY_COST_CARD=10
AUTONOMY_COST_MESSAGE=0
AUTONOMY_COST_MOMENT=20
AUTONOMY_COST_DIARY=5
AUTONOMY_COST_SEARCH=0
AUTONOMY_COST_TIDY=5
AUTONOMY_COST_REVIEW=3


# QQ 空间说说：接口支持不好，默认关
ENABLE_QZONE=0

# ===== Minecraft 分身 =====
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=DaFeiYu
# 必须和服务器版本一致，否则连不上
MC_VERSION=1.20.4
# offline=离线/局域网服；microsoft=正版服（设备码登录）
MC_AUTH=offline
# 只响应这个游戏ID的指令；留空则谁都听
MC_OWNER=
MC_REPLY_MIN_MS=900
MC_REPLY_MAX_MS=2600
MC_MAX_TOKENS=160

# ===== 面板 =====
# 面板端口和机器人端口（默认 8787 / 8788，一般不用改）
WEBUI_PORT=8787
BOT_API_PORT=8788
# 手机/别的电脑打开面板要输的密码；本机 127.0.0.1 不用
# 留空 = 只允许本机访问
PANEL_PASSWORD=

# ===== 记忆载体 =====
# 记忆的历史版本最多保留几份
HOUSE_KEEP=60
# 有变化且超过这么多分钟，才自动存一版
HOUSE_SNAPSHOT_MIN=20

# ===== 情绪恢复 =====
# 精力回满要几小时（线性）
MOOD_ENERGY_RECOVER_HOURS=6
# 精力自然恢复上限（1 = 能回满）
MOOD_ENERGY_RECOVER_CAP=100
# 情绪从最差回到中性要几小时
MOOD_VALENCE_RECOVER_HOURS=6
# 心情自主恢复最多走完多少百分比
MOOD_SELF_RECOVER_PERCENT=20

# ===== 精力消耗 =====
MOOD_COST_REPLY=2
MOOD_COST_TOOL=2



# ===== 记忆向量（算"意思像不像"用，跟聊天模型常常不是一家） =====
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024

# ===== 看图（可选） =====
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus

# ===== 语音（可选） =====
VOICE_CHARACTER=
